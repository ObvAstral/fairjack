# Copia in relayer/.env. Il backend legge anche relayer/deployment.json,
# generato da npm run deploy:local / deploy:sepolia.
RELAYER_HOST=127.0.0.1
RELAYER_PORT=3001
RELAYER_ALLOWED_ORIGIN=http://localhost:5173
RELAYER_MAX_SESSION_BUDGET_FJT=100
# IP/CIDR dei soli reverse proxy effettivamente usati, per il rate limit per IP.
# RELAYER_TRUST_PROXY=127.0.0.1/8,::1/128
# Per Sepolia: tutti i seguenti valori sono obbligatori e server-only.
# RELAYER_RPC_URL=https://your-server-rpc
# RELAYER_CHAIN_ID=11155111
# RELAYER_POOL_ADDRESS=0x...
# RELAYER_PRIVATE_KEY=0x...  # account dedicato finanziato con ETH Sepolia
# RELAYER_MAX_GAS_PER_TX=1500000
# RELAYER_MAX_FEE_GWEI=30
# RELAYER_DAILY_BUDGET_ETH=0.02
# DEALER_AUTO_FULFILL=false
# RELAYER_DB_PATH=relayer/data/relay.sqlite
