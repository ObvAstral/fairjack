{
  "name": "fairjack",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "frontend": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "abi:sync": "hardhat compile && node scripts/sync-abis.mjs",
    "relayer:dev": "node --env-file-if-exists=relayer/.env --import tsx relayer/src/server.ts",
    "relayer:build": "tsc -p relayer/tsconfig.json",
    "relayer:start": "node --env-file-if-exists=relayer/.env relayer/dist/relayer/src/server.js",
    "relayer:test": "hardhat test test/FairJack.relayer.test.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.7",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.1",
    "ethers": "^6.17.0",
    "hardhat": "^3.9.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@chainlink/contracts": "1.5.0",
    "@fastify/static": "^8.3.0",
    "@openzeppelin/contracts": "^5.6.1",
    "fastify": "^5.12.8"
  }
}
