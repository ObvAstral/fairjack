# Non-secret deployment settings. Store SEPOLIA_RPC_URL and SEPOLIA_PRIVATE_KEY
# in the encrypted Hardhat keystore (see README), not in frontend variables.
SEPOLIA_PUBLIC_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Servizio Chainlink VRF su Sepolia: NON è l'indirizzo di FairJackPool.
# Per il vecchio deploy FairJack: docs/deployments/sepolia-legacy.md (OBSOLETO).
VRF_WRAPPER_ADDRESS=0x195f15F2d49d693cE265b4fB0fdDbE15b1850Cc1
VRF_MAX_REQUEST_COST_ETH=0.005
# Optional irrevocable initial donation by the deployer; default is 0 on Sepolia.
ORACLE_RESERVE_ETH=0

# Optional custom endpoint for an isolated local Hardhat node.
# LOCAL_RPC_URL=http://127.0.0.1:8545
